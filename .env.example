# Optional: OpenSky OAuth2 client credentials (higher rate limits). Anonymous works without these.
# Create at https://opensky-network.org/ -> Account -> API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Default provider: adsblol | opensky
AERO_PROVIDER=adsblol
# Default region key (see aero_audit/config.py)
AERO_REGION=nyc
# Polling interval in seconds. adsb.lol returns HTTP 429 if you poll faster than ~every 10 s
# or run several pollers at once; keep ONE poller per host at >= 15 s.
AERO_POLL_INTERVAL=15

# HTTP transport: auto (httpx, fall back to curl on connect failure) | httpx | curl
AERO_HTTP_BACKEND=auto

# Local app security (see SECURITY.md). Leave unset for the default loopback mode.
# Shared access token, required only when binding beyond 127.0.0.1 (`aero app --host 0.0.0.0`).
AERO_APP_TOKEN=
# Load a model that is not in models/registry.json (a model is a pickle: only for files you produced).
AERO_ALLOW_UNVERIFIED_MODEL=0
