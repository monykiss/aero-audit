# Optional: OpenSky OAuth2 client credentials (higher rate limits). Anonymous works without these.
# Create at https://opensky-network.org/ -> Account -> API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Default provider: adsblol | opensky
AERO_PROVIDER=adsblol
# Default region key (see aero_audit/config.py)
AERO_REGION=nyc
# Polling interval in seconds. adsb.lol returns HTTP 429 if you poll faster than ~every 10 s
# or run several pollers at once; keep ONE poller per host at >= 15 s.
AERO_POLL_INTERVAL=15

# HTTP transport: auto (httpx, fall back to curl on connect failure) | httpx | curl
AERO_HTTP_BACKEND=auto

# Local app security (see SECURITY.md). Leave unset for the default loopback mode.
# Shared access token, required only when binding beyond 127.0.0.1 (`aero app --host 0.0.0.0`).
AERO_APP_TOKEN=
# Load a model that is not in models/registry.json (a model is a pickle: only for files you produced).
AERO_ALLOW_UNVERIFIED_MODEL=0

# Space (private branch). Everything below is optional: every space source has a keyless path.
# Space-Track.org: free account at https://www.space-track.org/auth/createAccount (approval takes a day or two).
# Unlocks public conjunction summaries (cdm_public), GP history, decay and TIP messages.
SPACETRACK_USER=
SPACETRACK_PASS=
# api.nasa.gov key (instant, by email at https://api.nasa.gov): DONKI space-weather notifications at 1,000/h.
# Without it DEMO_KEY is used automatically (30/h), which is enough for one poll per schedule interval.
NASA_API_KEY=
# GitHub token (optional): NASA-3D-Resources tree at 5,000/h instead of 60/h anonymous.
GITHUB_TOKEN=
# Scheduled intake inside `aero app`: job=seconds,... ; AERO_OFFLINE=1 skips network jobs.
# AERO_SCHEDULE=cdm_inbox=600,space_weather=900,launches=3600,spacetrack_pull=3600

