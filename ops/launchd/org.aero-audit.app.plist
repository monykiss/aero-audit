<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The local app, always up, with a live source started at boot (no demo injections). Install:
       cp ops/launchd/org.aero-audit.app.plist ~/Library/LaunchAgents/
       edit the /Users/you paths below, then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.aero-audit.app.plist
     The app binds loopback only; open http://127.0.0.1:8787/. Logs go to logs/app.out.log and logs/app.err.log.
     Credentials, if any, come from .env sourced by the shell wrapper; nothing is on this command line. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.aero-audit.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/you/Desktop/AERO &amp;&amp; [ -f ./.env ] &amp;&amp; source ./.env; exec .venv/bin/aero app --no-open --port 8787 --live nyc --interval 12</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/you/Desktop/AERO</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/you/Desktop/AERO/logs/app.out.log</string>
  <key>StandardErrorPath</key><string>/Users/you/Desktop/AERO/logs/app.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
